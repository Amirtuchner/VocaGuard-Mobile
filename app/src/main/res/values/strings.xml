    <!-- Onboarding -->
    <string name="onboarding_title_1">Real-time scam detection</string>
    <string name="onboarding_desc_1">VocaGuard listens for scam patterns during live calls and alerts you immediately — before you hand over any personal information.</string>
    <string name="onboarding_title_2">Permissions we need</string>
    <string name="onboarding_desc_2">To screen calls and transcribe speech, VocaGuard needs the Phone and Microphone permissions. Call audio is analyzed in real time solely to detect scam patterns.</string>
    <string name="onboarding_title_3">You\'re in control</string>
    <string name="onboarding_desc_3">Adjust detection sensitivity, whitelist trusted numbers, and review call transcripts whenever you like. VocaGuard works quietly in the background.</string>
    <string name="onboarding_title_4">Call Recording Notice</string>
    <string name="onboarding_desc_4">VocaGuard records call audio to detect scam patterns in real time. All audio is processed locally on your device and is never uploaded to any server. By tapping \"Get Started\" you consent to call audio recording for scam detection purposes.</string>
