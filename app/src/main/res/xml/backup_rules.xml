<?xml version="1.0" encoding="utf-8"?>
<!-- Used for devices below API 31. For API 31+ see data_extraction_rules.xml -->
<full-backup-content>
    <!-- Exclude sensitive data from ADB backups -->
    <exclude domain="sharedpref" path="vocaguard_transcripts.xml"/>
    <exclude domain="sharedpref" path="vocaguard_scam_db.xml"/>
    <exclude domain="sharedpref" path="vocaguard_network_scam_cache.xml"/>
    <exclude domain="sharedpref" path="vocaguard_whitelist.xml"/>
    <exclude domain="sharedpref" path="vocaguard_community_sync.xml"/>
    <!-- Exclude onboarding/registration state so a reinstall starts truly fresh:
         onboarding_complete / counters live in vocaguard_settings.xml, and SIP
         registration lives in server_detection.xml. Restoring these on reinstall
         skipped the setup wizard and desynced the app from the carrier's actual
         call-forwarding state (forwarding is carrier-side, not restorable). -->
    <exclude domain="sharedpref" path="vocaguard_settings.xml"/>
    <exclude domain="sharedpref" path="server_detection.xml"/>
    <exclude domain="database" path="vocaguard.db"/>
</full-backup-content>