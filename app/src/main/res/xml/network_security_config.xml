<?xml version="1.0" encoding="utf-8"?>
<!--
    Disallows all cleartext (HTTP) traffic across the app.
    Both the NumVerify API call and the community blocklist download already
    use HTTPS; this config ensures that can never regress.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust the system CA store only — no user-installed CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow plain HTTP to our Hetzner VPS token server (internal, no sensitive data) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">178.105.164.91</domain>
    </domain-config>
</network-security-config>
