<?xml version="1.0" encoding="utf-8"?>
<!--
    Disallows all cleartext (HTTP) traffic across the app.
    Both the NumVerify API call and the community blocklist download already
    use HTTPS; this config ensures that can never regress.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust the system CA store only — no user-installed CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Trust the self-signed TLS cert on our Hetzner VPS token server -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">178.105.164.91</domain>
        <trust-anchors>
            <certificates src="@raw/token_server_cert"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
